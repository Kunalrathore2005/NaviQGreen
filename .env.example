# NaviQGreen Environment Configuration

# Backend Settings
PROJECT_NAME="NaviQGreen"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"
SECRET_KEY="naviqgreen-super-secret-key-change-in-production-only"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Settings (PostgreSQL default for Docker, SQLite supported for zero-setup local runs)
DATABASE_URL=sqlite:///./naviqgreen.db
# For Docker PostgreSQL:
# DATABASE_URL=postgresql://naviq:naviqgreen_secure_pass@postgres:5432/naviqgreen_db

# CORS Settings (Comma-separated origins)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000"

# ML & Artifact Directories
ARTIFACTS_DIR="./artifacts"
DATASETS_DIR="./data"

# Frontend Settings (Used in frontend/.env)
VITE_API_BASE_URL="http://localhost:8000/api/v1"

